#!/usr/bin/env bash

DEF_VALUE=1

usage() {
  local script=${0##*/}

  cat <<-EOF
		USAGE: $script {up|down|toggle|mic} [value]

		Adjust audio volume, toggle mute, toggle microphone mute,
		and send a notification.

		OPTIONS:
		  up       [value]    Increase volume by [value] (default: $DEF_VALUE)
		  down     [value]    Decrease volume by [value] (default: $DEF_VALUE)
		  toggle              Toggle audio mute
		  mic                 Toggle microphone mute

		EXAMPLES:
		  Increase volume:
		    $ $script up

		  Decrease volume by 5:
		    $ $script down 5

		  Toggle audio mute:
		    $ $script toggle

		  Toggle microphone mute:
		    $ $script mic
	EOF
}

main() {
  local action=$1
  local value=${2:-$DEF_VALUE}
  local device title notification_id

  if [[ $action == "up" || $action == "down" ]]; then
    if ! [[ $value =~ ^[1-9][0-9]*$ ]]; then
      usage >&2
      return 1
    fi
  fi

  case $action in
  up | down)
    device='@DEFAULT_AUDIO_SINK@'
    title='Volume'
    notification_id='volume'
    local sign
    if [[ $action == up ]]; then sign='+'; else sign='-'; fi
    wpctl set-volume -l 1.0 "$device" "${value}%${sign}" || return 1
    ;;
  toggle)
    device='@DEFAULT_AUDIO_SINK@'
    title='Volume'
    notification_id='volume'
    wpctl set-mute "$device" toggle || return 1
    ;;
  mic)
    device='@DEFAULT_AUDIO_SOURCE@'
    title='Microphone'
    notification_id='microphone'
    wpctl set-mute "$device" toggle || return 1
    ;;
  *)
    usage >&2
    return 1
    ;;
  esac

  local vol_output
  vol_output=$(LC_NUMERIC=C wpctl get-volume "$device" 2>/dev/null) || return 1

  local volume
  volume=$(awk '{printf "%d", $2 * 100}' <<<"$vol_output")

  local muted icon
  if [[ $vol_output == *"[MUTED]"* ]]; then
    muted=' [Muted]'
    if [[ $device == '@DEFAULT_AUDIO_SOURCE@' ]]; then
      icon='microphone-sensitivity-muted'
    else
      icon='audio-volume-muted'
    fi
  else
    muted=''
    if [[ $device == '@DEFAULT_AUDIO_SOURCE@' ]]; then
      icon='microphone-sensitivity-high'
    else
      icon='audio-volume-high'
    fi
  fi

  notify-send "${title}: ${volume}%${muted}" \
    -h int:value:"$volume" \
    -i "$icon" \
    -h string:x-canonical-private-synchronous:"$notification_id"
}

main "$@"
