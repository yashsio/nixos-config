set notification-error-bg       "#1d2021"
set notification-error-fg       "#ea6962"

set notification-warning-bg     "#1d2021"
set notification-warning-fg     "#e78a4e"

set notification-bg             "#282828"
set notification-fg             "#d4be98"


set completion-bg               "#282828"
set completion-fg               "#d4be98"

set completion-group-bg         "#282828"
set completion-group-fg         "#928374"

set completion-highlight-bg     "#504945"
set completion-highlight-fg     "#d4be98"


set index-bg                    "#282828"
set index-fg                    "#928374"

set index-active-bg             "#504945"
set index-active-fg             "#d4be98"


set inputbar-bg                 "#282828"
set inputbar-fg                 "#d4be98"


set statusbar-bg                "#282828"
set statusbar-fg                "#d4be98"

set highlight-color        "rgba(216, 166, 87, 0.5)"
set highlight-active-color "rgba(169, 182, 101, 0.5)"

set default-bg                  "#1d2021"
set default-fg                  "#d4be98"

set render-loading              "true"
set render-loading-bg           "#1d2021"
set render-loading-fg           "#d4be98"


set recolor-lightcolor          "#1d2021"
set recolor-darkcolor           "#d4be98"

set recolor                     "true"

set pages-per-row 1

map J zoom out
map K zoom in
unmap f
map f toggle_fullscreen
map [fullscreen] f toggle_fullscreen
map r reload

map b toggle_page_mode 

unmap u
unmap d
map u scroll full-up
map d scroll full-down

set scroll-page-aware "true"
set scroll-full-overlap 0.01
set scroll-step 100

set zoom-min 5
set guioptions ""

set smooth-scroll "true"
set selection-clipboard clipboard
